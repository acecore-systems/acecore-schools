{
  "name": "acecore-schools",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && npm run audit:ai-chat && npm run audit:image-alts && npm run audit:links && npm run audit:structured-data && node scripts/build-search-corpus.mjs && npm run write:build-meta",
    "audit:ai-chat": "node scripts/audit-built-ai-chat.mjs",
    "audit:image-alts": "node scripts/audit-built-image-alts.mjs",
    "audit:links": "node scripts/audit-built-links.mjs",
    "audit:structured-data": "node scripts/audit-built-structured-data.mjs",
    "preview": "astro preview",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name acecore-schools",
    "format:check": "prettier . --check",
    "test:search": "node --experimental-strip-types --test tests/ai-chat-ui.test.mjs tests/deployment-marker.test.mjs tests/health-api.test.mjs tests/network-search-client.test.mjs tests/search-api.test.mjs tests/search-corpus.test.mjs tests/search-maintenance.test.mjs tests/vectorize-sync.test.mjs tests/vectorize-workflow.test.mjs",
    "test:ai-chat": "node --experimental-strip-types --test tests/ai-chat-ui.test.mjs",
    "test:structured-data": "node --test tests/structured-data.test.mjs",
    "sync:vectorize": "node scripts/sync-vectorize.mjs",
    "sync:vectorize:dry-run": "node scripts/sync-vectorize.mjs --dry-run",
    "write:build-meta": "node scripts/write-build-meta.mjs",
    "types:cloudflare": "wrangler types functions/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "types:cloudflare:check": "wrangler types functions/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false --check",
    "check:pages-config": "wrangler pages functions build --outdir .wrangler/pages-functions",
    "check:maintenance-config": "wrangler deploy --config wrangler.maintenance.jsonc --dry-run --outdir .wrangler/search-maintenance",
    "typecheck:functions": "tsc --project tsconfig.functions.json"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@phosphor-icons/web": "^2.1.2",
    "astro": "^7.1.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.116.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
