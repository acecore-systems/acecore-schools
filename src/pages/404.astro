---
import "../styles/tailwind.css";

const homeUrl = "/";
---

<!doctype html>
<html lang="ja" class="bg-error-canvas text-error-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="msvalidate.01" content="B670753BF4A50FA5437E5694CB04BAFD" />
    <title>ページが見つかりません | Acecore Schools</title>
    <meta name="robots" content="noindex, follow" />
  </head>
  <body class="grid min-h-screen place-items-center bg-error-canvas p-6 font-error text-error-ink">
    <main class="w-full max-w-[35rem]">
      <p class="mt-4 leading-[1.8] text-error-muted">404</p>
      <h1 class="my-[0.67em] text-4xl font-extrabold leading-[1.3] text-balance sm:text-5xl">
        ページが見つかりません
      </h1>
      <p class="mb-4 leading-[1.8] text-error-muted">
        お探しのページは移動または削除された可能性があります。トップページから目的の内容をご確認ください。
      </p>
      <a
        class="inline-flex min-h-13 items-center justify-center rounded-none bg-error-action px-6 font-bold text-white no-underline"
        href={homeUrl}
      >
        トップページへ
      </a>
    </main>
  </body>
</html>
