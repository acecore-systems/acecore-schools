---
import {
  acecoreContactUrl,
  acecoreOrigin,
  lineUrl,
  schoolsContent,
} from "../data/schools";

import ChatIcon from "./ChatIcon.astro";
import "../styles/shared-chat.css";
const chat = schoolsContent.aiChat;
const privacyUrl = `${acecoreOrigin}/privacy/`;
---

<div
  class="schools-ai-chat ac-chat"
  data-schools-ai-chat
  data-search-ignore
  data-endpoint="/api/ai-chat"
  data-greeting={chat.greeting}
  data-loading={chat.loading}
  data-error={chat.errors.generic}
  data-timeout={chat.errors.timeout}
  data-too-long={chat.errors.tooLong}
>
  <section
    class="schools-ai-chat-panel ac-chat__panel"
    id="schools-ai-chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="schools-ai-chat-title"
    aria-describedby="schools-ai-chat-description"
    data-schools-ai-chat-panel
    hidden
  >
    <header class="schools-ai-chat-header ac-chat__header">
      <span class="schools-ai-chat-mark ac-chat__mark" aria-hidden="true">
        <ChatIcon name="bot" />
      </span>
      <div class="ac-chat__heading">
        <h2 id="schools-ai-chat-title">{chat.title}</h2>
        <p id="schools-ai-chat-description">{chat.lead}</p>
      </div>
      <button
        class="schools-ai-chat-close ac-chat__close"
        type="button"
        aria-label={chat.close}
        data-schools-ai-chat-close
      >
        <ChatIcon name="close" />
      </button>
    </header>

    <div
      class="schools-ai-chat-messages ac-chat__messages"
      role="log"
      aria-live="polite"
      aria-relevant="additions"
      data-schools-ai-chat-messages
    ></div>

    <div
      class="schools-ai-chat-prompts ac-chat__prompts"
      aria-label={chat.quickPromptLabel}
    >
      {chat.quickPrompts.map((prompt) => (
        <button type="button" data-schools-ai-chat-prompt data-prompt={prompt}>
          {prompt}
        </button>
      ))}
    </div>

    <form class="ac-chat__form" data-schools-ai-chat-form>
      <label for="schools-ai-chat-input" class="sr-only">
        {chat.inputLabel}
      </label>
      <div class="ac-chat__input-row">
        <textarea
          id="schools-ai-chat-input"
          rows="2"
          maxlength="800"
          placeholder={chat.placeholder}
          aria-describedby="schools-ai-chat-hint schools-ai-chat-count"
          data-schools-ai-chat-input
          required
        ></textarea>
        <button
          type="submit"
          class="ac-chat__send"
          aria-label={chat.send}
          data-schools-ai-chat-submit
        >
          <ChatIcon name="send" />
        </button>
      </div>

      <div class="schools-ai-chat-input-meta ac-chat__input-meta">
        <p id="schools-ai-chat-hint">{chat.inputHint}</p>
        <p id="schools-ai-chat-count" data-schools-ai-chat-count>
          0 / 800
        </p>
      </div>
    </form>
    <div class="ac-chat__footer">
      <nav class="schools-ai-chat-contact" aria-label={chat.contactLabel}>
        <a href={acecoreContactUrl}>{chat.contactForm}</a>
        <a href={lineUrl} target="_blank" rel="noopener noreferrer">
          {chat.line}
        </a>
      </nav>

      <p class="schools-ai-chat-privacy">
        {chat.privacyBefore}
        <a href={privacyUrl}>{chat.privacyLink}</a>
        {chat.privacyAfter}
      </p>
    </div>
  </section>

  <button
    class="schools-ai-chat-toggle ac-chat__toggle"
    type="button"
    aria-controls="schools-ai-chat-panel"
    aria-expanded="false"
    aria-label={chat.open}
    data-schools-ai-chat-toggle
  >
    <ChatIcon name="bot" />
    <span aria-hidden="true">AI</span>
  </button>
</div>

<script>
  import "../scripts/shared-chat-viewport";
  import { initSchoolsAiChat } from "./schools-ai-chat";

  const initializeSchoolsAiChat = () => {
    document
      .querySelectorAll<HTMLElement>("[data-schools-ai-chat]")
      .forEach(initSchoolsAiChat);
  };

  initializeSchoolsAiChat();
  document.addEventListener("astro:page-load", initializeSchoolsAiChat);
</script>
