---
import "@phosphor-icons/web/regular";
import ActivitySection from "./ActivitySection.astro";
import ConsultationSection from "./ConsultationSection.astro";
import {
  acecoreContactUrl,
  acecoreOrigin,
  lineUrl,
  schoolsContent,
  schoolsOrigin,
} from "../data/schools";

type PageKey =
  | "home"
  | "learning"
  | "how-it-works"
  | "pricing"
  | "about"
  | "faq"
  | "activity";

interface Props {
  page?: PageKey;
}

const content = schoolsContent;
const { page = "home" } = Astro.props;

const pageConfigs = {
  home: {
    path: "/",
    eyebrow: "ACECORE SCHOOLS",
    title: "目的から学びを組み立てるスクール",
    description: content.description,
    heroImage: {
      src: "/images/schools/purpose-city/hero-city.webp",
      alt: content.hero.imageAlt,
      width: 1800,
      height: 900,
      position: "center center",
    },
  },
  learning: {
    path: "/learning/",
    eyebrow: "LEARNING AREAS",
    title: "学べること",
    description:
      "高卒認定、IT・プログラミング、PC・スマホ活用、ロボット／メイキングの4領域と、学びの先で目指すことを紹介します。",
    heroImage: {
      src: "/images/schools/purpose-city/hero-learning.webp",
      alt: "教材、ノートパソコン、スマートフォン、小型電子部品を並べて学ぶ内容を整理する受講者",
      width: 1536,
      height: 806,
      position: "68% center",
    },
  },
  "how-it-works": {
    path: "/how-it-works/",
    eyebrow: "HOW IT WORKS",
    title: "学び方・サポート",
    description:
      "目的の整理から計画、実践、見直しまでの進め方と、オンラインでの受講方法を紹介します。",
    heroImage: {
      src: "/images/schools/purpose-city/hero-how-it-works.webp",
      alt: "カードとノートを使って学習の順番を相談する受講者と講師",
      width: 1536,
      height: 806,
      position: "68% center",
    },
  },
  pricing: {
    path: "/pricing/",
    eyebrow: "PRICE GUIDE",
    title: "料金",
    description:
      "Acecore Schoolsの入会金、月謝、教材・管理費の税込目安と、受講前に確認できる内容を紹介します。",
    heroImage: {
      src: "/images/schools/purpose-city/hero-pricing.webp",
      alt: "受講内容と費用の提案資料を相談相手と確認する受講希望者",
      width: 1536,
      height: 806,
      position: "70% center",
    },
  },
  about: {
    path: "/about/",
    eyebrow: "ABOUT SCHOOLS",
    title: "Schoolsについて",
    description:
      "Acecore Schoolsの考え方、運営元Acecoreとのつながり、これまでの取り組みを紹介します。",
    heroImage: {
      src: "/images/schools/purpose-city/hero-about.webp",
      alt: "ノートパソコンと電子機材のあるスタジオで教材を準備する運営者",
      width: 1536,
      height: 806,
      position: "70% center",
    },
  },
  faq: {
    path: "/faq/",
    eyebrow: "FAQ",
    title: "よくあるご質問",
    description:
      "学習内容、対象、料金、必要な機器、対面企画など、Acecore Schoolsによく寄せられる質問に回答します。",
    heroImage: {
      src: "/images/schools/purpose-city/hero-faq.webp",
      alt: "オンライン相談で受講前の疑問を質問する受講希望者",
      width: 1536,
      height: 806,
      position: "68% center",
    },
  },
  activity: {
    path: "/activities/2023-summer-robot-workshop/",
    eyebrow: content.activityRecord.eyebrow,
    title: content.activityRecord.title,
    description: content.activityRecord.description,
    heroImage: {
      src: "/images/schools/purpose-city/workshop-robot-summer.webp",
      alt: content.activityRecord.imageAlt,
      width: 1536,
      height: 1024,
      position: "center center",
    },
  },
} as const satisfies Record<
  PageKey,
  {
    path: string;
    eyebrow: string;
    title: string;
    description: string;
    heroImage: {
      src: string;
      alt: string;
      width: number;
      height: number;
      position: string;
    };
  }
>;

const pageConfig = pageConfigs[page];
const canonicalPath = pageConfig.path;
const canonicalUrl = new URL(canonicalPath, schoolsOrigin).href;
const pageTitle =
  page === "home"
    ? `${content.title} | ${pageConfig.title}`
    : `${pageConfig.title} | ${content.title}`;
const pageHeroImageUrl = new URL(pageConfig.heroImage.src, schoolsOrigin).href;
const homeHeroImageUrl = new URL(pageConfigs.home.heroImage.src, schoolsOrigin)
  .href;
const workshopImage = pageConfigs.activity.heroImage.src;
const supportImage = "/images/schools/purpose-city/support-call.webp";
const acecoreLogo = `${acecoreOrigin}/favicon.svg`;
const currentYear = new Date().getFullYear();

const homeUrl = new URL("/", schoolsOrigin).href;
const organizationId = `${homeUrl}#organization`;
const websiteId = `${homeUrl}#website`;
const educationServiceId = `${homeUrl}#education-service`;
const webpageId = `${canonicalUrl}#webpage`;
const activityArticleId = `${canonicalUrl}#article`;
const pageOgType = page === "activity" ? "article" : "website";
const servicePageKeys = new Set<PageKey>([
  "learning",
  "how-it-works",
  "pricing",
  "faq",
]);

const jsonLdGraph: Record<string, unknown>[] = [
  {
    "@type": "EducationalOrganization",
    "@id": organizationId,
    name: content.title,
    description: content.description,
    url: homeUrl,
    image: homeHeroImageUrl,
    inLanguage: "ja",
    knowsAbout: content.areas.flatMap((area) => [area.title, ...area.examples]),
    parentOrganization: {
      "@type": "Organization",
      name: "Acecore",
      url: acecoreOrigin,
    },
  },
  {
    "@type": "Service",
    "@id": educationServiceId,
    name: content.title,
    description: content.description,
    url: homeUrl,
    serviceType: content.areas.map((area) => area.title),
    provider: { "@id": organizationId },
    availableChannel: {
      "@type": "ServiceChannel",
      serviceUrl: new URL("/how-it-works/", schoolsOrigin).href,
      availableLanguage: {
        "@type": "Language",
        name: "Japanese",
        alternateName: "ja",
      },
    },
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: content.title,
    url: homeUrl,
    description: content.description,
    inLanguage: "ja",
    publisher: { "@id": organizationId },
  },
  {
    "@type": "WebPage",
    "@id": webpageId,
    url: canonicalUrl,
    name: pageTitle,
    description: pageConfig.description,
    image: pageHeroImageUrl,
    inLanguage: "ja",
    isPartOf: { "@id": websiteId },
    about: { "@id": organizationId },
    ...(page === "activity"
      ? { mainEntity: { "@id": activityArticleId } }
      : servicePageKeys.has(page)
        ? { mainEntity: { "@id": educationServiceId } }
        : {}),
  },
];

if (page === "faq") {
  jsonLdGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq-schema`,
    url: canonicalUrl,
    inLanguage: "ja",
    isPartOf: { "@id": websiteId },
    about: { "@id": educationServiceId },
    mainEntity: content.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}

if (page === "activity") {
  const eventIds = content.activityRecord.eventDates.map(
    (_, index) => `${canonicalUrl}#event-${index + 1}`,
  );

  content.activityRecord.eventDates.forEach((eventDate, index) => {
    jsonLdGraph.push({
      "@type": "Event",
      "@id": eventIds[index],
      name: `${content.activityRecord.title}（${eventDate.label}）`,
      description: content.activityRecord.description,
      image: pageHeroImageUrl,
      url: eventIds[index],
      startDate: eventDate.startDate,
      endDate: eventDate.endDate,
      eventStatus: "https://schema.org/EventCompleted",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      location: {
        "@type": "Place",
        name: content.activityRecord.locationName,
      },
      organizer: { "@id": organizationId },
    });
  });

  jsonLdGraph.push({
    "@type": "Article",
    "@id": activityArticleId,
    url: canonicalUrl,
    headline: content.activityRecord.title,
    description: content.activityRecord.description,
    image: pageHeroImageUrl,
    datePublished: content.activityRecord.publishedAt,
    dateModified: content.activityRecord.modifiedAt,
    inLanguage: "ja",
    isPartOf: { "@id": websiteId },
    mainEntityOfPage: { "@id": webpageId },
    author: { "@id": organizationId },
    publisher: { "@id": organizationId },
    about: eventIds.map((eventId) => ({ "@id": eventId })),
  });
}

if (page !== "home") {
  jsonLdGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: content.title,
        item: homeUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: pageConfig.title,
        item: canonicalUrl,
      },
    ],
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": jsonLdGraph,
};

const homeOverview = [
  {
    icon: "ph-books",
    label: "LEARNING",
    title: "学べること",
    body: "4つの領域を、目的に合わせて組み合わせます。",
    href: "/learning/",
  },
  {
    icon: "ph-path",
    label: "HOW IT WORKS",
    title: "学び方",
    body: "相談と実践を往復しながら、内容とペースを組み直します。",
    href: "/how-it-works/",
  },
  {
    icon: "ph-receipt",
    label: "PRICE GUIDE",
    title: "料金",
    body: "入会金、月謝、教材・管理費の税込目安を確認できます。",
    href: "/pricing/",
  },
  {
    icon: "ph-buildings",
    label: "ABOUT",
    title: "Schoolsについて",
    body: "教育事業としての考え方と、運営元Acecoreとのつながりを紹介します。",
    href: "/about/",
  },
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="B670753BF4A50FA5437E5694CB04BAFD" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageConfig.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageConfig.description} />
    <meta property="og:type" content={pageOgType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={content.title} />
    <meta property="og:image" content={pageHeroImageUrl} />
    <meta property="og:image:alt" content={pageConfig.heroImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageConfig.description} />
    <meta name="twitter:image" content={pageHeroImageUrl} />
    <meta name="twitter:image:alt" content={pageConfig.heroImage.alt} />
    {
      page === "activity" && (
        <>
          <meta
            property="article:published_time"
            content={content.activityRecord.publishedAt}
          />
          <meta
            property="article:modified_time"
            content={content.activityRecord.modifiedAt}
          />
          <meta property="article:section" content="活動記録" />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={acecoreLogo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header" data-header>
      <div class="brand-lockup" aria-label="Acecore Schools">
        <a
          class="brand-parent"
          href={acecoreOrigin}
          aria-label="Acecore 公式サイト"
        >
          <img src={acecoreLogo} alt="Acecore ロゴ" width="32" height="32" />
          <span>Acecore</span>
        </a>
        <span class="brand-divider" aria-hidden="true">/</span>
        <a class="brand-school" href="/">Schools</a>
      </div>

      <button
        class="menu-toggle"
        type="button"
        aria-controls="site-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">メニューを開く</span>
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>

      <nav
        class="primary-nav"
        id="site-navigation"
        aria-label="メインメニュー"
        data-navigation
      >
        {
          content.nav.map((item) => (
            <a
              href={item.href}
              aria-current={page === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        class="header-cta"
        href={lineUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        無料相談を申し込む
      </a>
    </header>

    <main id="main-content" tabindex="-1">
      {
        page !== "home" && (
          <section class="subpage-hero" aria-labelledby="page-title">
            <img
              class="subpage-hero-image"
              src={pageConfig.heroImage.src}
              alt={pageConfig.heroImage.alt}
              width={pageConfig.heroImage.width}
              height={pageConfig.heroImage.height}
              loading="eager"
              fetchpriority="high"
              style={`object-position: ${pageConfig.heroImage.position};`}
            />
            <div class="page-shell">
              <nav class="breadcrumbs" aria-label="パンくず">
                <ol>
                  <li>
                    <a href="/">トップ</a>
                  </li>
                  <li aria-current="page">{pageConfig.title}</li>
                </ol>
              </nav>
              <p class="section-label">{pageConfig.eyebrow}</p>
              <h1 id="page-title">{pageConfig.title}</h1>
              <p class="subpage-description">{pageConfig.description}</p>
            </div>
          </section>
        )
      }

      {
        page === "home" && (
          <>
            <section class="hero" aria-labelledby="hero-title">
              <img
                class="hero-image"
                src={pageConfig.heroImage.src}
                alt={pageConfig.heroImage.alt}
                width={pageConfig.heroImage.width}
                height={pageConfig.heroImage.height}
                loading="eager"
                fetchpriority="high"
              />
              <div class="hero-layout page-shell">
                <h1 id="hero-title">{content.hero.title}</h1>
                <div class="hero-message">
                  <p class="hero-lead">{content.hero.lead}</p>
                  <p class="hero-body">{content.hero.body}</p>
                  <div class="hero-actions">
                    <a
                      class="button button-primary"
                      href={lineUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {content.hero.primary}
                      <i class="ph ph-arrow-right" aria-hidden="true" />
                    </a>
                    <a class="button button-secondary" href="/learning/">
                      {content.hero.secondary}
                    </a>
                  </div>
                </div>
              </div>
            </section>

            <section class="purpose-selector" aria-labelledby="purpose-title">
              <div class="page-shell">
                <p class="section-label" id="purpose-title">
                  今日の目的から選ぶ
                </p>
                <div class="purpose-grid">
                  {content.purposes.map((purpose) => (
                    <a
                      class:list={["purpose-card", `purpose-${purpose.tone}`]}
                      href={purpose.href}
                    >
                      <i class:list={["ph", purpose.icon]} aria-hidden="true" />
                      <strong>{purpose.title}</strong>
                      <i
                        class="ph ph-arrow-right purpose-arrow"
                        aria-hidden="true"
                      />
                    </a>
                  ))}
                </div>
              </div>
            </section>

            <section
              class="home-overview section-block"
              aria-labelledby="overview-title"
            >
              <div class="page-shell">
                <div class="section-heading heading-row">
                  <div>
                    <p class="section-label">EXPLORE SCHOOLS</p>
                    <h2 id="overview-title">知りたいことから選ぶ</h2>
                  </div>
                  <p>
                    ページごとに内容を整理しました。いま確認したいことから進めます。
                  </p>
                </div>
                <div class="overview-grid">
                  {homeOverview.map((item) => (
                    <a class="overview-card" href={item.href}>
                      <i class:list={["ph", item.icon]} aria-hidden="true" />
                      <span>{item.label}</span>
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                      <strong>
                        詳しく見る
                        <i class="ph ph-arrow-right" aria-hidden="true" />
                      </strong>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          </>
        )
      }

      {
        page === "how-it-works" && (
          <section
            class="support section-block"
            id="support"
            aria-labelledby="support-title"
          >
            <div class="support-layout page-shell">
              <div class="support-copy">
                <div class="section-heading">
                  <p class="section-label">INDIVIDUAL SUPPORT</p>
                  <h2 id="support-title">{content.support.title}</h2>
                  <p>{content.support.body}</p>
                </div>
                <div class="support-list">
                  {content.support.points.map((point) => (
                    <article class="support-item">
                      <i class:list={["ph", point.icon]} aria-hidden="true" />
                      <div>
                        <h3>{point.title}</h3>
                        <p>{point.body}</p>
                      </div>
                    </article>
                  ))}
                </div>
                <div class="support-audience">
                  <span>{content.support.audience.label}</span>
                  <div>
                    <strong>{content.support.audience.title}</strong>
                    <p>{content.support.audience.body}</p>
                  </div>
                </div>
              </div>
              <figure class="support-media">
                <img
                  src={supportImage}
                  alt={content.support.imageAlt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                />
              </figure>
            </div>
          </section>
        )
      }

      {
        page === "learning" && (
          <section
            class="learning-areas section-block"
            id="areas"
            aria-labelledby="areas-title"
          >
            <div class="page-shell">
              <div class="section-heading heading-row">
                <div>
                  <p class="section-label">LEARNING AREAS</p>
                  <h2 id="areas-title">学べる4つの領域</h2>
                </div>
                <p>
                  固定講座の一覧ではありません。目的に合わせて、扱う領域と実施方法を相談しながら組み立てます。
                </p>
              </div>
              <div class="area-grid">
                {content.areas.map((area) => (
                  <article class="area-card" id={area.id}>
                    <figure>
                      <img
                        src={area.image}
                        alt={area.imageAlt}
                        width="1536"
                        height="1024"
                        loading="lazy"
                      />
                    </figure>
                    <div class="area-body">
                      <div class="area-meta">
                        <span>{area.number}</span>
                        <i class:list={["ph", area.icon]} aria-hidden="true" />
                      </div>
                      <p class="area-purpose">{area.purpose}</p>
                      <h3>{area.title}</h3>
                      <p>{area.body}</p>
                      <div class="area-examples">
                        <span>相談できる内容の例</span>
                        <ul>
                          {area.examples.map((example) => (
                            <li>
                              <i class="ph ph-check" aria-hidden="true" />
                              <span>{example}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <a href="#consultation">
                        内容と実施方法を相談
                        <i class="ph ph-arrow-right" aria-hidden="true" />
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        page === "how-it-works" && (
          <>
            <section
              class="process section-block"
              id="process"
              aria-labelledby="process-title"
            >
              <div class="page-shell">
                <div class="section-heading process-heading">
                  <p class="section-label">{content.process.eyebrow}</p>
                  <h2 id="process-title">{content.process.title}</h2>
                  <p>{content.process.body}</p>
                </div>
                <div class="process-grid">
                  {content.process.steps.map((step) => (
                    <article class="process-step">
                      <span class="process-number">{step.number}</span>
                      <i class:list={["ph", step.icon]} aria-hidden="true" />
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                    </article>
                  ))}
                </div>
              </div>
            </section>

            <section
              class="support-system section-block"
              aria-labelledby="support-system-title"
            >
              <div class="page-shell">
                <div class="section-heading heading-row compact-heading">
                  <div>
                    <p class="section-label">SUPPORT</p>
                    <h2 id="support-system-title">
                      {content.supportSystem.title}
                    </h2>
                  </div>
                </div>
                <div class="system-grid">
                  {content.supportSystem.items.map((item) => (
                    <article>
                      <i class:list={["ph", item.icon]} aria-hidden="true" />
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          </>
        )
      }

      {
        page === "learning" && (
          <section
            class="outcomes section-block"
            id="outcomes"
            aria-labelledby="outcomes-title"
          >
            <div class="page-shell">
              <div class="section-heading heading-row">
                <div>
                  <p class="section-label">{content.outcomes.eyebrow}</p>
                  <h2 id="outcomes-title">{content.outcomes.title}</h2>
                </div>
                <p>{content.outcomes.body}</p>
              </div>
              <div class="outcome-grid">
                {content.outcomes.items.map((item) => (
                  <article class="outcome-card">
                    <img
                      src={item.image}
                      alt={item.imageAlt}
                      width="1536"
                      height="1024"
                      loading="lazy"
                    />
                    <div>
                      <span>{item.label}</span>
                      <h3>{item.title}</h3>
                    </div>
