    <script>
      const header = document.querySelector("[data-header]");
      const toggle = document.querySelector("[data-menu-toggle]");
      const navigation = document.querySelector("[data-navigation]");

      const legacyHashRoutes: Record<string, string> = {
        "#support": "/how-it-works/#support",
        "#areas": "/learning/#areas",
        "#ged": "/learning/#ged",
        "#programming": "/learning/#programming",
        "#digital": "/learning/#digital",
        "#making": "/learning/#making",
        "#outcomes": "/learning/#outcomes",
        "#process": "/how-it-works/#process",
        "#delivery": "/how-it-works/#delivery",
        "#activity": "/about/#activity",
        "#pricing": "/pricing/#pricing",
        "#faq": "/faq/#faq",
      };

      const redirectLegacyHash = () => {
        const legacyDestination = legacyHashRoutes[window.location.hash];
        if (window.location.pathname === "/" && legacyDestination) {
          window.location.replace(legacyDestination);
        }
      };

      redirectLegacyHash();
      window.addEventListener("hashchange", redirectLegacyHash);

      const closeMenu = (restoreFocus = false) => {
        if (
          !(header instanceof HTMLElement) ||
          !(toggle instanceof HTMLButtonElement)
        ) {
          return;
        }
        header.classList.remove("menu-open");
        toggle.setAttribute("aria-expanded", "false");
        const label = toggle.querySelector(".sr-only");
        if (label) label.textContent = "メニューを開く";
        const icon = toggle.querySelector("i");
        if (icon) icon.className = "ph ph-list";
        if (restoreFocus) toggle.focus();
      };

      toggle?.addEventListener("click", () => {
        if (
          !(header instanceof HTMLElement) ||
          !(toggle instanceof HTMLButtonElement)
        ) {
          return;
        }
        const open = header.classList.toggle("menu-open");
        toggle.setAttribute("aria-expanded", String(open));
        const label = toggle.querySelector(".sr-only");
        if (label)
          label.textContent = open ? "メニューを閉じる" : "メニューを開く";
        const icon = toggle.querySelector("i");
        if (icon) icon.className = open ? "ph ph-x" : "ph ph-list";
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => closeMenu());
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && header?.classList.contains("menu-open")) {
          closeMenu(true);
        }
      });

      document.addEventListener("click", (event) => {
        if (
          header instanceof HTMLElement &&
          event.target instanceof Node &&
          !header.contains(event.target)
        ) {
          closeMenu();
        }
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 980) closeMenu();
      });
    </script>
