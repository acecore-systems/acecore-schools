---
import "@phosphor-icons/web/regular";
import {
  acecoreOrigin,
  lineUrl,
  schoolsContent,
  schoolsOrigin,
} from "../data/schools";

const content = schoolsContent;
const canonicalPath = "/";
const canonicalUrl = new URL(canonicalPath, schoolsOrigin).href;
const pageTitle = `${content.title} | 目的から学びを組み立てるスクール`;
const heroImage = "/images/schools/purpose-city/hero-city.webp";
const heroImageUrl = new URL(heroImage, schoolsOrigin).href;
const supportImage = "/images/schools/purpose-city/support-call.webp";
const workshopImage =
  "/images/schools/purpose-city/workshop-robot-summer.webp";

const organizationId = `${canonicalUrl}#organization`;
const websiteId = `${canonicalUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": organizationId,
      name: content.title,
      description: content.description,
      url: canonicalUrl,
      image: heroImageUrl,
      inLanguage: "ja",
      knowsAbout: content.areas.map((area) => area.title),
      parentOrganization: {
        "@type": "Organization",
        name: "Acecore",
        url: acecoreOrigin,
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: content.title,
      url: canonicalUrl,
      description: content.description,
      inLanguage: "ja",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: canonicalUrl,
      name: pageTitle,
      description: content.description,
      image: heroImageUrl,
      inLanguage: "ja",
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq-schema`,
      mainEntity: content.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="B670753BF4A50FA5437E5694CB04BAFD" />
    <title>{pageTitle}</title>
    <meta name="description" content={content.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={content.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={content.title} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:image:alt" content={content.hero.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={content.description} />
    <meta name="twitter:image" content={heroImageUrl} />
    <meta name="twitter:image:alt" content={content.hero.imageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header" data-header>
      <a class="brand" href={canonicalPath} aria-label="Acecore Schools ホーム">
        <span>Acecore Schools</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-controls="site-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">メニューを開く</span>
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>

      <nav
        class="primary-nav"
        id="site-navigation"
        aria-label="メインメニュー"
        data-navigation
      >
        {
          content.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
        <a class="nav-about" href={`${acecoreOrigin}/about/`}>
          Acecore Schoolsについて
        </a>
      </nav>

      <a
        class="header-cta"
        href={lineUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        無料相談を申し込む
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src={heroImage}
          alt={content.hero.imageAlt}
          width="2048"
          height="1152"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-layout page-shell">
          <h1 id="hero-title">{content.hero.title}</h1>
          <div class="hero-message">
            <p class="hero-lead">{content.hero.lead}</p>
            <p class="hero-body">{content.hero.body}</p>
            <div class="hero-actions">
              <a
                class="button button-primary"
                href={lineUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {content.hero.primary}
                <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
              <a class="button button-secondary" href="#areas">
                {content.hero.secondary}
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="purpose-selector" aria-labelledby="purpose-title">
        <div class="page-shell">
          <p class="section-label" id="purpose-title">今日の目的から選ぶ</p>
          <div class="purpose-grid">
            {
              content.purposes.map((purpose) => (
                <a
                  class:list={["purpose-card", `purpose-${purpose.tone}`]}
                  href={purpose.href}
                >
                  <i class:list={["ph", purpose.icon]} aria-hidden="true" />
                  <strong>{purpose.title}</strong>
                  <i class="ph ph-arrow-right purpose-arrow" aria-hidden="true" />
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="support section-block" id="support" aria-labelledby="support-title">
        <div class="support-layout page-shell">
          <div class="support-copy">
            <div class="section-heading">
              <p class="section-label">INDIVIDUAL SUPPORT</p>
              <h2 id="support-title">{content.support.title}</h2>
              <p>{content.support.body}</p>
            </div>
            <div class="support-list">
              {
                content.support.points.map((point) => (
                  <article class="support-item">
                    <i class:list={["ph", point.icon]} aria-hidden="true" />
                    <div>
                      <h3>{point.title}</h3>
                      <p>{point.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
          <figure class="support-media">
            <img
              src={supportImage}
              alt={content.support.imageAlt}
              width="1536"
              height="1024"
              loading="lazy"
            />
          </figure>
        </div>
      </section>

      <section class="learning-areas section-block" id="areas" aria-labelledby="areas-title">
        <div class="page-shell">
          <div class="section-heading heading-row">
            <div>
              <p class="section-label">LEARNING AREAS</p>
              <h2 id="areas-title">学べる4つの領域</h2>
            </div>
            <p>
              固定講座の一覧ではありません。目的に合わせて、扱う領域と実施方法を相談しながら組み立てます。
            </p>
          </div>
          <div class="area-grid">
            {
              content.areas.map((area) => (
                <article class="area-card" id={area.id}>
                  <figure>
                    <img
                      src={area.image}
                      alt={area.imageAlt}
                      width="1536"
                      height="1024"
                      loading="lazy"
                    />
                  </figure>
                  <div class="area-body">
                    <div class="area-meta">
                      <span>{area.number}</span>
                      <i class:list={["ph", area.icon]} aria-hidden="true" />
                    </div>
                    <p class="area-purpose">{area.purpose}</p>
                    <h3>{area.title}</h3>
                    <p>{area.body}</p>
                    <a href="#consultation">
                      内容と実施方法を相談
                      <i class="ph ph-arrow-right" aria-hidden="true" />
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="process section-block" id="process" aria-labelledby="process-title">
        <div class="page-shell">
          <div class="section-heading process-heading">
            <p class="section-label">{content.process.eyebrow}</p>
            <h2 id="process-title">{content.process.title}</h2>
            <p>{content.process.body}</p>
          </div>
          <div class="process-grid">
            {
              content.process.steps.map((step) => (
                <article class="process-step">
                  <span class="process-number">{step.number}</span>
                  <i class:list={["ph", step.icon]} aria-hidden="true" />
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="support-system section-block" aria-labelledby="support-system-title">
        <div class="page-shell">
          <div class="section-heading heading-row compact-heading">
            <div>
              <p class="section-label">SUPPORT</p>
              <h2 id="support-system-title">{content.supportSystem.title}</h2>
            </div>
          </div>
          <div class="system-grid">
            {
              content.supportSystem.items.map((item) => (
                <article>
                  <i class:list={["ph", item.icon]} aria-hidden="true" />
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="outcomes section-block" id="outcomes" aria-labelledby="outcomes-title">
        <div class="page-shell">
          <div class="section-heading heading-row">
            <div>
              <p class="section-label">{content.outcomes.eyebrow}</p>
              <h2 id="outcomes-title">{content.outcomes.title}</h2>
            </div>
            <p>{content.outcomes.body}</p>
          </div>
          <div class="outcome-grid">
            {
              content.outcomes.items.map((item) => (
                <article class="outcome-card">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    width="1536"
                    height="1024"
                    loading="lazy"
                  />
                  <div>
                    <span>{item.label}</span>
                    <h3>{item.title}</h3>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="facts section-block" id="activity" aria-label="取り組みと受講方法">
        <div class="facts-grid page-shell">
          <article class="activity-card">
            <div class="fact-copy">
              <p class="section-label">{content.activity.eyebrow}</p>
              <h2>{content.activity.title}</h2>
              <p class="fact-lead">{content.activity.body}</p>
              <p class="fact-note">{content.activity.note}</p>
            </div>
            <img
              src={workshopImage}
              alt={content.activity.imageAlt}
              width="1536"
              height="1024"
              loading="lazy"
            />
          </article>

          <article class="delivery-card" id="delivery">
            <div class="fact-copy">
              <p class="section-label">{content.delivery.eyebrow}</p>
              <h2>{content.delivery.title}</h2>
              <p class="fact-lead">{content.delivery.body}</p>
              <p class="fact-note">{content.delivery.note}</p>
            </div>
            <ul>
              {
                content.delivery.items.map((item) => (
                  <li>
                    <i class:list={["ph", item.icon]} aria-hidden="true" />
                    <span>{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </section>

      <section class="consultation section-block" id="consultation" aria-labelledby="consultation-title">
        <div class="page-shell">
          <div class="section-heading consultation-heading">
            <p class="section-label">{content.consultation.eyebrow}</p>
            <h2 id="consultation-title">{content.consultation.title}</h2>
            <p>{content.consultation.body}</p>
          </div>
          <ol class="consultation-steps">
            {
              content.consultation.steps.map((step) => (
                <li>
                  <span>{step.number}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <a
            class="button button-primary consultation-button"
            href={lineUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {content.consultation.cta}
            <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
          </a>
        </div>
      </section>

      <section class="faq section-block" id="faq" aria-labelledby="faq-title">
        <div class="faq-layout page-shell">
          <div class="section-heading faq-heading">
            <p class="section-label">FAQ</p>
            <h2 id="faq-title">{content.faq.title}</h2>
            <p>
              ここにない内容も、無料相談で気軽に聞いてください。
            </p>
          </div>
          <div class="faq-list">
            {
              content.faq.items.map((item) => (
                <details>
                  <summary>
                    <span>{item.question}</span>
                    <i class="ph ph-plus" aria-hidden="true" />
                  </summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-layout page-shell">
        <div class="footer-brand">
          <a href={canonicalPath}>Acecore Schools</a>
          <p>{content.footer.tagline}</p>
        </div>
        <nav aria-label="フッターメニュー">
          {
            content.nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a href={`${acecoreOrigin}/about/`}>Acecore Schoolsについて</a>
          <a href={`${acecoreOrigin}/privacy-policy/`}>プライバシーポリシー</a>
        </nav>
      </div>
    </footer>

    <script>
      const header = document.querySelector("[data-header]");
      const toggle = document.querySelector("[data-menu-toggle]");
      const navigation = document.querySelector("[data-navigation]");

      const closeMenu = () => {
        if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLElement)) {
          return;
        }
        header.classList.remove("menu-open");
        toggle.setAttribute("aria-expanded", "false");
        const label = toggle.querySelector(".sr-only");
        if (label) label.textContent = "メニューを開く";
        const icon = toggle.querySelector("i");
        if (icon) icon.className = "ph ph-list";
      };

      toggle?.addEventListener("click", () => {
        if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLElement)) {
          return;
        }
        const open = header.classList.toggle("menu-open");
        toggle.setAttribute("aria-expanded", String(open));
        const label = toggle.querySelector(".sr-only");
        if (label) label.textContent = open ? "メニューを閉じる" : "メニューを開く";
        const icon = toggle.querySelector("i");
        if (icon) icon.className = open ? "ph ph-x" : "ph ph-list";
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 980) closeMenu();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --canvas: #f7f8f5;
    --canvas-blue: #f3f7fa;
    --ink: #102433;
    --navy: #0a3569;
    --navy-dark: #05284f;
    --green: #087d62;
    --green-dark: #065a49;
    --muted: #53616b;
    --line: #ccd6df;
    --line-strong: #9fb0bf;
    --shadow: 0 18px 44px rgba(20, 50, 73, 0.09);
    --sans:
      "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo,
      sans-serif;
    --serif:
      "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  body,
  button,
  a {
    font-family: var(--sans);
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  button {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p,
  figure,
  ul,
  ol {
    margin: 0;
  }

  ul,
  ol {
    padding: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.42;
  }

  h2 {
    font-family: var(--serif);
    font-size: clamp(2rem, 3.2vw, 3.35rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  h3 {
    font-size: 1.05rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .page-shell {
    width: min(1360px, calc(100% - 72px));
    margin-inline: auto;
  }

  .section-block {
    padding-block: 96px;
  }

  .section-label {
    color: var(--green);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .section-heading {
    display: grid;
    gap: 15px;
  }

  .section-heading > p:last-child {
    max-width: 690px;
    color: var(--muted);
  }

  .heading-row {
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    gap: 56px;
    align-items: end;
    margin-bottom: 40px;
  }

  .heading-row > div {
    display: grid;
    gap: 13px;
  }

  .compact-heading {
    margin-bottom: 30px;
  }

  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
    min-height: 76px;
    border-bottom: 1px solid rgba(10, 53, 105, 0.12);
    padding: 0 max(30px, calc((100vw - 1450px) / 2));
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 5px 24px rgba(10, 53, 105, 0.05);
  }

  .brand {
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-nav {
    display: flex;
    gap: clamp(16px, 2vw, 30px);
    align-items: center;
    justify-content: flex-end;
  }

  .primary-nav a {
    color: #344654;
    font-size: 0.79rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    color: var(--green);
  }

  .nav-about {
    color: var(--muted) !important;
    font-size: 0.72rem !important;
  }

  .header-cta,
  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 12px 22px;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .header-cta,
  .button-primary {
    background: var(--navy);
    color: white;
  }

  .header-cta:hover,
  .header-cta:focus-visible,
  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--navy-dark);
    transform: translateY(-2px);
  }

  .button-secondary {
    border-color: var(--navy);
    background: rgba(255, 255, 255, 0.84);
    color: var(--navy);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    background: var(--navy);
    color: white;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
    cursor: pointer;
    font-size: 1.55rem;
  }

  .hero {
    position: relative;
    min-height: clamp(570px, 64vw, 760px);
    overflow: hidden;
    background: #edf0ef;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 220px minmax(310px, 460px);
    gap: 48px;
    align-items: center;
    min-height: inherit;
  }

  .hero h1 {
    width: fit-content;
    padding: 24px 18px;
    background: rgba(255, 255, 255, 0.82);
    font-family: var(--serif);
    font-size: clamp(4rem, 6vw, 6.7rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.12;
    white-space: nowrap;
    writing-mode: vertical-rl;
  }

  .hero-message {
    align-self: center;
    width: min(100%, 460px);
    padding: 32px;
    background: rgba(255, 255, 255, 0.86);
  }

  .hero-lead {
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.1vw, 2.1rem);
    font-weight: 600;
    line-height: 1.65;
  }

  .hero-body {
    margin-top: 18px;
    color: #3d4b55;
    font-size: 0.95rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .purpose-selector {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--line);
    padding-block: 28px 42px;
    background: var(--paper);
  }

  .purpose-selector .section-label {
    margin-bottom: 14px;
    color: var(--ink);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .purpose-grid {
    display: grid;
