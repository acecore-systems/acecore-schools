---
import castRelease from "../data/cast-release.json";
import { schoolsContent } from "../data/schools";

const data = schoolsContent.learningStarts;
const cards = data.items.map((item) => {
  const image = castRelease.assets.find(
    (asset) => asset.subjectId === item.subjectId,
  );
  if (!image)
    throw new Error(`Missing approved cast portrait: ${item.subjectId}`);
  return { ...item, image };
});
---

<section
  class="learning-starts section-block"
  aria-labelledby="learning-starts-title"
>
  <div class="page-shell">
    <div class="section-heading heading-row">
      <div>
        <p class="section-label">YOUR STARTING POINT</p>
        <h2 id="learning-starts-title">{data.title}</h2>
      </div>
      <p>{data.body}</p>
    </div>
    <div class="learning-starts-grid">
      {
        cards.map((item) => (
          <article class="learning-start-card">
            <figure>
              <img
                src={item.image.url}
                alt={item.imageAlt}
                width={item.image.width}
                height={item.image.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{data.aiLabel}</figcaption>
            </figure>
            <div class="learning-start-copy">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <a href={item.href}>
                {item.label}
                <i class="ph ph-arrow-right" aria-hidden="true" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="learning-starts-disclosure">
      {data.disclaimer}{" "}
      <a href="https://cast.acecore.net/">{data.sourceLabel}</a>
    </p>
  </div>
</section>
