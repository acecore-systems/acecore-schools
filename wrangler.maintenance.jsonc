{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acecore-schools-search-maintenance",
  "main": "./workers/semantic-search-maintenance.ts",
  "compatibility_date": "2026-06-07",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "SEARCH_PREVIEW_DB",
      "database_name": "acecore-schools-search-preview",
      "database_id": "9ec6b1bb-92c1-4706-9977-aeedd7f27111",
      "migrations_dir": "./migrations/search",
    },
    {
      "binding": "SEARCH_PRODUCTION_DB",
      "database_name": "acecore-schools-search-production",
      "database_id": "60908c5d-897e-4d17-9b17-2632ac4fde14",
      "migrations_dir": "./migrations/search",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
