/.well-known/acecore-schools-build.json
  Cache-Control: no-store
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

/_astro/*.js
  X-Robots-Tag: noindex

/_astro/*.css
  X-Robots-Tag: noindex

/_astro/*.map
  X-Robots-Tag: noindex

/pagefind/*
  X-Robots-Tag: noindex

/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
